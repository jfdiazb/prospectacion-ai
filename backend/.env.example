# BACKEND CONFIGURATION (.env)

# Server
NODE_ENV=development
PORT=5001
API_URL=http://localhost:5001

# Frontend
FRONTEND_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/prospectacion-ai
# Para MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/prospectacion-ai?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@prospectacion-ai.com

# Redis (para Bull queue)
REDIS_URL=redis://localhost:6379

# Social Media APIs (para future integraciones)
INSTAGRAM_TOKEN=your-instagram-token
FACEBOOK_TOKEN=your-facebook-token
WHATSAPP_TOKEN=your-whatsapp-token

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
