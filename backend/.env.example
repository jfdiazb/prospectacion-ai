# BACKEND CONFIGURATION (.env)

# Server
NODE_ENV=development
PORT=5001
API_URL=http://localhost:5001

# Frontend
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/prospectacion-ai
# Para MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prospectacion-ai?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=30d

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
AI_MODE=mock

# YouTube (canal principal)
YOUTUBE_MESSAGING_MODE=mock
YOUTUBE_POLL_OVERLAP_MS=3600000
YOUTUBE_REPLY_POLL_INTERVAL_MS=120000
YOUTUBE_REPLY_ACTIVE_DAYS=7
YOUTUBE_REPLY_MAX_THREADS=5
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_TIMEOUT_MS=10000

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@prospectacion-ai.com

# Redis (para Bull queue)
REDIS_URL=redis://localhost:6379

# Social Media APIs (para future integraciones)
INSTAGRAM_TOKEN=your-instagram-token
FACEBOOK_TOKEN=your-facebook-token
WHATSAPP_TOKEN=your-whatsapp-token
VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_AUTO_REPLY_ENABLED=false
CRM_OWNER_ID=your-mongodb-user-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-meta-webhook-verify-token
META_ACCESS_TOKEN=your-meta-access-token
META_IG_USER_ID=your-instagram-account-id
META_GRAPH_API_VERSION=v23.0
META_MESSAGING_MODE=mock
INSTAGRAM_MESSAGING_MODE=mock
META_MESSAGING_TIMEOUT_MS=10000
META_WEBHOOK_URL=https://your-public-host.example/api/v1/meta/webhook
META_MOCK_MODE=true
WHATSAPP_MESSAGING_MODE=mock
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=
ZOOM_MODE=mock

# Browser security
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
