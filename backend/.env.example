# BACKEND CONFIGURATION (.env)

# Server
NODE_ENV=development
PORT=5001
API_URL=http://localhost:5001

# Smoke autenticado (solo operador/CI; no guardar estos valores en Git)
ALMA_SMOKE_API_URL=http://localhost:5001
ALMA_SMOKE_EMAIL=
ALMA_SMOKE_PASSWORD=
ALMA_SMOKE_TIMEOUT_MS=10000

# Frontend
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/prospectacion-ai
# Para MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prospectacion-ai?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=30d

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
AI_MODE=mock

# YouTube (canal principal)
YOUTUBE_MESSAGING_MODE=mock
YOUTUBE_LAUNCH_EVENT_TOLERANCE_MS=3600000
YOUTUBE_HUNTER_MODE=mock
YOUTUBE_HUNTER_DAILY_SEARCH_LIMIT=100
YOUTUBE_HUNTER_USER_DAILY_SEARCH_LIMIT=25
YOUTUBE_HUNTER_MAX_RESULTS=20
YOUTUBE_HUNTER_MAX_CANDIDATES=20
YOUTUBE_HUNTER_DEFAULT_MIN_SCORE=75
YOUTUBE_HUNTER_DEFAULT_RECENT_DAYS=90
YOUTUBE_HUNTER_CACHE_MS=21600000
YOUTUBE_POLL_OVERLAP_MS=3600000
YOUTUBE_REPLY_POLL_INTERVAL_MS=120000
YOUTUBE_REPLY_ACTIVE_DAYS=7
YOUTUBE_REPLY_MAX_THREADS=5
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_TIMEOUT_MS=10000

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@prospectacion-ai.com

# Redis (para Bull queue)
REDIS_URL=redis://localhost:6379

# Social Media APIs (para future integraciones)
INSTAGRAM_TOKEN=your-instagram-token
FACEBOOK_TOKEN=your-facebook-token
WHATSAPP_TOKEN=your-whatsapp-token
VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_AUTO_REPLY_ENABLED=false
TIKTOK_API_APPROVED=false
TIKTOK_INGESTION_ENABLED=false
TIKTOK_MESSAGING_ENABLED=false
TIKTOK_LAUNCH_EVENT_TOLERANCE_MS=3600000
WHATSAPP_REPLY_MODE=assisted
WHATSAPP_INBOUND_MAX_AGE_MS=600000
WHATSAPP_ACTIVATION_ALLOWLIST=
CRM_OWNER_ID=your-mongodb-user-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-meta-webhook-verify-token
META_ACCESS_TOKEN=your-meta-access-token
META_IG_USER_ID=your-instagram-account-id
META_GRAPH_API_VERSION=v23.0
META_MESSAGING_MODE=mock
INSTAGRAM_MESSAGING_MODE=mock
FACEBOOK_MESSAGING_MODE=mock
META_AUTO_SEND_ENABLED=false
META_INITIAL_INTENT_PHRASES=INFO,quiero información,más información,me interesa,información
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_MESSAGING_MODE=mock
META_MESSAGING_TIMEOUT_MS=10000
META_WEBHOOK_URL=https://your-public-host.example/api/v1/meta/webhook
META_MOCK_MODE=true
META_INBOUND_MAX_AGE_MS=600000
META_LAUNCH_EVENT_TOLERANCE_MS=600000
WHATSAPP_MESSAGING_MODE=mock
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=
ZOOM_MODE=mock

# Disponibilidad persistida en Meeting antes de invocar Zoom
SCHEDULING_MODE=zoom
MEETING_AVAILABLE_DAYS=1,2,3,4,5
MEETING_START_TIME=19:30
MEETING_END_TIME=20:30
MEETING_DURATION_MINUTES=30
MEETING_TIMEZONE=America/Bogota
MEETING_BUFFER_BEFORE_MINUTES=0
MEETING_BUFFER_AFTER_MINUTES=0
MEETING_HORIZON_DAYS=14
MEETING_MAX_OPTIONS=3

# Browser security
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Lanzamientos L6B: webhook inbound firmado (desactivado mientras secreto/owner estén vacíos)
LAUNCH_FORM_WEBHOOK_SECRET=
LAUNCH_FORM_WEBHOOK_OWNER_ID=
LAUNCH_FORM_WEBHOOK_ACCOUNT_ID=controlled-form
LAUNCH_FORM_WEBHOOK_TOLERANCE_MS=300000
LAUNCH_FORM_WEBHOOK_MAX_PAYLOAD_BYTES=65536

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Durable assisted follow-up policy (never sends automatically)
FOLLOWUP_MAX_ATTEMPTS=3
FOLLOWUP_COOLDOWN_MS=86400000
REACTIVATION_INACTIVITY_MS=1209600000
REACTIVATION_COOLDOWN_MS=2592000000
REACTIVATION_MAX_ATTEMPTS=2
REACTIVATION_PROPOSAL_TTL_MS=604800000
MEETING_REMINDER_WINDOWS_MINUTES=1440,60
MEETING_REMINDER_MIN_LEAD_MINUTES=10
MEETING_OPTIONS_TTL_MS=86400000
MEETING_POST_FOLLOWUP_DELAY_MS=3600000
MEETING_PROPOSAL_TTL_MS=86400000
MEETING_OUTCOME_REVIEW_GRACE_MS=3600000
QUALIFICATION_WARM_SCORE=50
QUALIFICATION_HOT_SCORE=80
QUALIFICATION_INTERESTED_SCORE=70
QUALIFICATION_DOWNGRADE_MARGIN=10
QUALIFICATION_INTENT_HISTORY_LIMIT=12
