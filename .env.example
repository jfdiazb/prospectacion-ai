# Prospectación AI - Environment Variables Template
# Copia este archivo como .env y reemplaza los valores

# ============================================
# Backend Configuration
# ============================================

# Node Environment
NODE_ENV=development
PORT=5001

# Database
MONGO_URI=mongodb://localhost:27017/prospectacion-ai
# Para MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/prospectacion-ai?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=24h

# Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
AI_MODE=mock

# YouTube Data API (canal principal)
YOUTUBE_MESSAGING_MODE=mock
YOUTUBE_INGESTION_MODE=mock
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:5001/api/v1/youtube/oauth/callback
YOUTUBE_OAUTH_STATE_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# YOUTUBE_POLL_INTERVAL_MS=60000
# YOUTUBE_TIMEOUT_MS=10000

# Email Configuration (Optional - para email service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@prospectacion-ai.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=30

# CORS Configuration
CORS_ORIGIN=https://app.example.com

# ============================================
# Frontend Configuration
# ============================================

VITE_API_URL=http://localhost:5001/api/v1
VITE_APP_NAME=Prospectación AI
VITE_APP_VERSION=1.0.0

# ============================================
# Optional Services
# ============================================

# Redis (para session/cache - opcional)
REDIS_URL=redis://localhost:6379

# Sentry (error tracking - opcional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Production Environment (Deployment)
# ============================================

# WhatsApp Cloud API (cuando se habilite la integración oficial)
VERIFY_TOKEN=replace-with-a-random-verification-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_TOKEN=your-system-user-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_AUTO_REPLY_ENABLED=false
WHATSAPP_MESSAGING_MODE=mock

# Instagram Messaging API (Meta)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_API_VERSION=v23.0
META_MESSAGING_MODE=mock
# Nombre explícito preferido; META_MESSAGING_MODE se conserva por compatibilidad
INSTAGRAM_MESSAGING_MODE=mock
# META_MESSAGING_TIMEOUT_MS=10000
# Solo desarrollo/pruebas; nunca habilitar en producción
META_MOCK_MODE=false

# Zoom Server-to-Server OAuth
ZOOM_MODE=mock
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Email o ID del usuario anfitrión con licencia para crear reuniones
ZOOM_USER_ID=
# ZOOM_TIMEOUT_MS=10000
# ZOOM_MEETING_DURATION_MINUTES=30

# Agenda segura (Calendly controla disponibilidad y crea Zoom al reservar)
SCHEDULING_MODE=zoom
CALENDLY_BOOKING_URL=https://calendly.com/tu-usuario/reunion-alma
# Necesaria para sincronizar reservas/cancelaciones por POST /api/v1/calendly/webhook
CALENDLY_WEBHOOK_SIGNING_KEY=
# Alternativa para webhooks internos creados con token personal
CALENDLY_WEBHOOK_SECRET=
CALENDLY_PERSONAL_ACCESS_TOKEN=
CALENDLY_POLL_INTERVAL_MS=120000
CALENDLY_LOOKAHEAD_DAYS=90
CALENDLY_TIMEOUT_MS=10000

# Para Render/Railway Backend:
# NODE_ENV=production
# JWT_SECRET=<generate-a-random-32-plus-character-secret>

# Para Vercel Frontend:
# VITE_API_URL=https://your-backend.onrender.com/api/v1
