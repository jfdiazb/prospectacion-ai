# Prospectación AI - Environment Variables Template
# Copia este archivo como .env y reemplaza los valores

# ============================================
# Backend Configuration
# ============================================

# Node Environment
NODE_ENV=development
PORT=5001

# Database
MONGO_URI=mongodb://localhost:27017/prospectacion-ai
# Para MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/prospectacion-ai?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=24h

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=5001
OPENAI_TEMPERATURE=0.7

# Email Configuration (Optional - para email service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@prospectacion-ai.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=30

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# ============================================
# Frontend Configuration
# ============================================

VITE_API_URL=http://localhost:5001/api/v1
VITE_APP_NAME=Prospectación AI
VITE_APP_VERSION=1.0.0

# ============================================
# Optional Services
# ============================================

# Redis (para session/cache - opcional)
REDIS_URL=redis://localhost:6379

# Sentry (error tracking - opcional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Production Environment (Deployment)
# ============================================

# Para Render Backend:
# NODE_ENV=production
# DATABASE_URL=postgresql://...
# JWT_SECRET=<generate-random-secure-key>
# OPENAI_API_KEY=sk-...

# Para Vercel Frontend:
# VITE_API_URL=https://your-backend.onrender.com/api/v1
